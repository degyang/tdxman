{
  "schema_version": 1,
  "id": "market_four_dimensions",
  "name": "市场四维评分",
  "version": 1,
  "calculator": "weighted_dimensions_v1",
  "scope": "exclude_known_st",
  "frequencies": [
    "D",
    "W",
    "M"
  ],
  "feature_definition": "stock_market_features_v1",
  "inputs": {
    "up_pct": {
      "source": "market_summary",
      "fields": {
        "D": "up_pct",
        "W": "daily_up_pct_weighted",
        "M": "daily_up_pct_weighted"
      },
      "unit": "percent"
    },
    "avg_return": {
      "source": "market_summary",
      "fields": {
        "D": "avg_return",
        "W": "daily_avg_return_weighted",
        "M": "daily_avg_return_weighted"
      },
      "unit": "fraction"
    },
    "median_return": {
      "source": "market_summary",
      "fields": {
        "D": "median_return",
        "W": "daily_median_return_mean",
        "M": "daily_median_return_mean"
      },
      "unit": "fraction"
    },
    "strong_up_pct": {
      "source": "market_summary",
      "fields": {
        "D": "strong_up_pct",
        "W": "daily_strong_up_pct_weighted",
        "M": "daily_strong_up_pct_weighted"
      },
      "unit": "percent"
    },
    "strong_down_pct": {
      "source": "market_summary",
      "fields": {
        "D": "strong_down_pct",
        "W": "daily_strong_down_pct_weighted",
        "M": "daily_strong_down_pct_weighted"
      },
      "unit": "percent"
    },
    "limit_up": {
      "source": "market_summary",
      "fields": {
        "D": "close_limit_up_count",
        "W": "daily_limit_up_mean",
        "M": "daily_limit_up_mean"
      },
      "unit": "count_or_daily_mean"
    },
    "seal_rate": {
      "source": "market_summary",
      "fields": {
        "D": "sealed_ratio",
        "W": "sealed_ratio",
        "M": "sealed_ratio"
      },
      "unit": "ratio"
    },
    "max_consecutive": {
      "source": "market_summary",
      "fields": {
        "D": "max_consecutive_up",
        "W": "end_max_consecutive_up",
        "M": "end_max_consecutive_up"
      },
      "unit": "count"
    },
    "above_ma20_pct": {
      "source": "market_summary",
      "fields": {
        "D": "above_ma20_pct",
        "W": "above_ma20_pct",
        "M": "above_ma20_pct"
      },
      "unit": "ratio"
    },
    "index_return": {
      "source": "index_daily",
      "symbol": "000001.SH",
      "unit": "fraction",
      "methods": {
        "D": "close_over_previous_market_session_close_minus_one",
        "W": "last_period_close_over_preperiod_close_minus_one",
        "M": "last_period_close_over_preperiod_close_minus_one"
      },
      "missing_sessions": "unavailable",
      "include_predecessor": true
    }
  },
  "input_validation": {
    "percent": {
      "min": 0,
      "max": 100
    },
    "ratio": {
      "min": 0,
      "max": 1
    },
    "fraction": {
      "min": -1
    },
    "count": {
      "min": 0,
      "integer": true
    },
    "count_or_daily_mean": {
      "min": 0,
      "integer_frequencies": [
        "D"
      ]
    },
    "nonfinite": "missing",
    "boolean": "missing"
  },
  "dimensions": {
    "profit": {
      "weight": 0.35,
      "terms": [
        {
          "inputs": [
            "up_pct"
          ],
          "transform": "identity",
          "scale": 1,
          "low": 21,
          "high": 75,
          "weight": 0.45,
          "invert": false
        },
        {
          "inputs": [
            "avg_return"
          ],
          "transform": "identity",
          "scale": 100,
          "low": -1.2,
          "high": 1.3,
          "weight": 0.25,
          "invert": false
        },
        {
          "inputs": [
            "median_return"
          ],
          "transform": "identity",
          "scale": 100,
          "low": -1.2,
          "high": 1.3,
          "weight": 0.2,
          "invert": false
        },
        {
          "inputs": [
            "strong_up_pct",
            "strong_down_pct"
          ],
          "transform": "difference",
          "scale": 1,
          "low": -13,
          "high": 14,
          "weight": 0.1,
          "invert": false
        }
      ]
    },
    "speculation": {
      "weight": 0.25,
      "terms": [
        {
          "inputs": [
            "limit_up"
          ],
          "transform": "identity",
          "scale": 1,
          "low": 35,
          "high": 97,
          "weight": 0.3,
          "invert": false
        },
        {
          "inputs": [
            "seal_rate"
          ],
          "transform": "identity",
          "scale": 100,
          "low": 57,
          "high": 75,
          "weight": 0.4,
          "invert": false
        },
        {
          "inputs": [
            "max_consecutive"
          ],
          "transform": "identity",
          "scale": 1,
          "low": 4,
          "high": 9,
          "weight": 0.3,
          "invert": false
        }
      ]
    },
    "resilience": {
      "weight": 0.2,
      "terms": [
        {
          "inputs": [
            "strong_down_pct"
          ],
          "transform": "identity",
          "scale": 1,
          "low": 2,
          "high": 18,
          "weight": 1,
          "invert": true
        }
      ]
    },
    "trend": {
      "weight": 0.2,
      "terms": [
        {
          "inputs": [
            "index_return"
          ],
          "transform": "identity",
          "scale": 100,
          "low": -2.5,
          "high": 2.5,
          "weight": 0.5,
          "invert": false
        },
        {
          "inputs": [
            "above_ma20_pct"
          ],
          "transform": "identity",
          "scale": 100,
          "low": 22,
          "high": 76,
          "weight": 0.5,
          "invert": false
        }
      ]
    }
  },
  "normalization": {
    "kind": "linear",
    "rounding": "python_ties_to_even",
    "clamp": [
      0,
      100
    ],
    "round_each_term": true,
    "round_dimension": false,
    "round_total": true
  },
  "states": [
    {
      "min_inclusive": 70,
      "name": "strong"
    },
    {
      "min_inclusive": 55,
      "name": "lean_strong"
    },
    {
      "min_inclusive": 45,
      "name": "range"
    },
    {
      "min_inclusive": 30,
      "name": "lean_weak"
    },
    {
      "min_inclusive": 0,
      "name": "weak"
    }
  ],
  "missing_policy": {
    "dimension": "null_if_any_term_missing",
    "total": "null_if_any_dimension_missing",
    "preserve_other_dimensions": true
  },
  "quality_policy": {
    "speculation": "strict",
    "require_zero_fields": {
      "D": [
        "limit_unknown_count",
        "limit_invalid_count",
        "streak_unknown_count"
      ],
      "W": [
        "limit_unknown_observations",
        "limit_invalid_observations",
        "streak_unknown_observations"
      ],
      "M": [
        "limit_unknown_observations",
        "limit_invalid_observations",
        "streak_unknown_observations"
      ]
    },
    "missing_quality_field": "dimension_unavailable",
    "no_trade": "excluded"
  },
  "frequency_overrides": {
    "D": {
      "parameters": "base",
      "status": "existing_daily_formula_new_feature_semantics",
      "warmup_periods": 0
    },
    "W": {
      "parameters": "inherit_D_explicitly",
      "status": "experimental_uncalibrated",
      "warmup_periods": 0
    },
    "M": {
      "parameters": "inherit_D_explicitly",
      "status": "experimental_uncalibrated",
      "warmup_periods": 0
    }
  },
  "parameter_overrides_allowed": [
    "dimensions.*.weight",
    "dimensions.*.terms.*.weight",
    "dimensions.*.terms.*.low",
    "dimensions.*.terms.*.high"
  ],
  "output_fields": [
    "period_key",
    "as_of",
    "frequency",
    "scope",
    "model_id",
    "template_hash",
    "parameters_hash",
    "profit_score",
    "speculation_score",
    "resilience_score",
    "trend_score",
    "score_unrounded",
    "score",
    "state",
    "input_quality",
    "reasons"
  ],
  "phase_smoothing": null,
  "notes": [
    "Daily formula matches Fundwise 1b256585 score_market; new feature definitions may change actual scores.",
    "Weekly/monthly use aggregated daily market conditions with uncalibrated daily thresholds.",
    "This template is a design artifact; production loader and calculator have not been implemented."
  ]
}
